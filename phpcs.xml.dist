<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="WP Skeleton"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

    <description>A custom set of rules to check for a WPized WordPress project</description>

    <!-- Scan only PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Scan all files in directory -->
    <file>.</file>

    <!-- Exclude the Composer Vendor directory. -->
    <exclude-pattern>web/wp</exclude-pattern>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>tools/*</exclude-pattern>
    <exclude-pattern>web/app/db-error.php</exclude-pattern>
    <exclude-pattern>web/app/maintenance.php</exclude-pattern>
    <exclude-pattern>web/app/plugins/*/autoload.php</exclude-pattern>
    <exclude-pattern>web/app/themes/*/src/</exclude-pattern>
    <exclude-pattern>web/app/themes/*/autoload.php</exclude-pattern>
    <exclude-pattern>web/app/*/*/assets/acf/</exclude-pattern>

    <!-- Exclude the plugins -->
    <exclude-pattern>web/app/plugins/advanced-custom-fields-pro/</exclude-pattern>
    <exclude-pattern>web/app/plugins/advanced-responsive-images/</exclude-pattern>
    <exclude-pattern>web/app/plugins/bbq-pro/</exclude-pattern>
    <exclude-pattern>web/app/plugins/beapi-maintenance-mode/</exclude-pattern>
    <exclude-pattern>web/app/plugins/delete-expired-transients/</exclude-pattern>
    <exclude-pattern>web/app/plugins/debug/</exclude-pattern>
    <exclude-pattern>web/app/plugins/debug-*/</exclude-pattern>
    <exclude-pattern>web/app/plugins/disable-*/</exclude-pattern>
    <exclude-pattern>web/app/plugins/duracelltomi-google-tag-manager/</exclude-pattern>
    <exclude-pattern>web/app/plugins/optimus/</exclude-pattern>
    <exclude-pattern>web/app/plugins/query-monitor/</exclude-pattern>
    <exclude-pattern>web/app/plugins/redirection/</exclude-pattern>
    <exclude-pattern>web/app/plugins/rewrite-rules-inspector/</exclude-pattern>
    <exclude-pattern>web/app/plugins/safe-svg/</exclude-pattern>
    <exclude-pattern>web/app/plugins/user-switching/</exclude-pattern>
    <exclude-pattern>web/app/plugins/wordpress-seo/</exclude-pattern>
    <exclude-pattern>web/app/plugins/wp-cerber/</exclude-pattern>
    <exclude-pattern>web/app/plugins/wp-http-blocklist/</exclude-pattern>
    <exclude-pattern>web/app/plugins/wp-sentry-integration/</exclude-pattern>
    <exclude-pattern>web/app/plugins/wp-thumb/</exclude-pattern>

    <!-- Exclude languages files -->
    <exclude-pattern>web/app/languages/</exclude-pattern>

    <!-- Exclude plugins build folder -->
    <exclude-pattern>web/app/plugins/*/build/</exclude-pattern>

    <!-- Exclude the Node Modules directory. -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- <<< EXCLUDE EXTERNAL (MU-)PLUGINS OR THEMES HERE >>> -->
    <exclude-pattern>web/app/mu-plugins/autoload/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/bea-wp-thumb/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/beapi-zeroconf-auto-login/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/bedrock-disallow-indexing/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/disable-xmlrpc/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/logger/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/missed-schedule/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/multisite-url-fixer/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/plugin-redirection/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/prod-images/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/redirect-loop-detector/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/sanitize-filename/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/wp-login-page/</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/bedrock-autoloader.php</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/register-theme-directory.php</exclude-pattern>
    <exclude-pattern>web/app/mu-plugins/*/</exclude-pattern>
    <!-- <<< EXCLUDE EXTERNAL (MU-)PLUGINS OR THEMES HERE >>> -->

    <rule ref="WordPress-Extra">
        <!-- Exclude as we use a custom autoloader. -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Exclude as it conflict with @var declaration. -->
        <exclude name="Squiz.PHP.CommentedOutCode.Found"/>

        <!-- Exclude as we use the short array syntax over the long one. -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

        <!-- Allow to use short ternary operators since they are very useful. -->
        <exclude name="WordPress.PHP.DisallowShortTernary.Found"/>
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Show sniff name in report. -->
    <arg value="sp"/>

    <!-- Show progress. -->
    <arg value="p"/>

    <!-- Use colors. -->
    <arg name="colors"/>

    <!-- Set ini. -->
    <ini name="memory_limit" value="512M"/>
    <ini name="max_execution_time" value="-1"/>

    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="bea_get_attachment_image" />
            </property>
        </properties>
    </rule>
</ruleset>
