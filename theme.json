{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "base",
					"color": "var(--wp--custom--color--light)",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "var(--wp--custom--color--dark)",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "var(--wp--custom--color--yellow)",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "var(--wp--custom--color--grey-400)",
					"name": "Secondary"
				}
			]
		},
		"layout": {
			"contentSize": "700px",
			"wideSize": "1140px"
		},
		"custom": {
			"color": {
				"dark": "#000000",
				"light": "#ffffff",
				"yellow": "#ffe600",
				"grey-100": "#eee",
				"grey-200": "#ccc",
				"grey-300": "#aaa",
				"grey-400": "#999"
			},
			"typography": {
				"line-height": {
					"100": 1.1,
					"200": 1.2,
					"300": 1.25,
					"400": 1.5,
					"500": 1.75
				}
			}
		},
		"spacing": {
			"units": [ "px" ],
			"blockGap": true,
			"customSpacingSize": false,
			"spacingSizes": [
				{
					"name": "1",
					"size": "0.5rem",
					"slug": "1"
				},
				{
					"name": "2",
					"size": "1rem",
					"slug": "2"
				},
				{
					"name": "3",
					"size": "clamp(1rem, 0.8236rem + 0.7526vw, 1.5rem)",
					"slug": "3"
				},
				{
					"name": "4",
					"size": "clamp(1.5rem, 1.3236rem + 0.7526vw, 2rem)",
					"slug": "4"
				},
				{
					"name": "5",
					"size": "clamp(2rem, 1.8236rem + 0.7526vw, 2.5rem)",
					"slug": "5"
				},
				{
					"name": "6",
					"size": "clamp(2.5rem, 2.3236rem + 0.7526vw, 3rem)",
					"slug": "6"
				},
				{
					"name": "7",
					"size": "clamp(3rem, 2.6472rem + 1.5052vw, 4rem)",
					"slug": "7"
				},
				{
					"name": "8",
					"size": "clamp(4rem, 3.6472rem + 1.5052vw, 5rem)",
					"slug": "8"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"customFontSize": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Inter\", sans-serif",
					"name": "Inter",
					"slug": "primary",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Regular.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Light.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Medium.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./assets/fonts/Inter-Bold.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "X Small (14px)",
					"size": "0.875rem",
					"slug": "x-small"
				},
				{
					"name": "Small (16px)",
					"size": "1rem",
					"slug": "small",
					"fluid": false
				},
				{
					"name": "Medium (24px)",
					"size": "1.5rem",
					"slug": "medium",
					"fluid": false
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					},
					"name": "Large (32px)",
					"size": "2rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "2.5rem"
					},
					"name": "X Large (40px)",
					"size": "2.5rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "2.5rem",
						"max": "3rem"
					},
					"name": "XX Large (48px)",
					"size": "3rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"min": "3rem",
						"max": "4.5rem"
					},
					"name": "XXX Large (72px)",
					"size": "4.5rem",
					"slug": "xxx-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"lineHeight": "var(--wp--custom--typography--line-height--200)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"button": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--2)",
						"right": "var(--wp--preset--spacing--3)",
						"bottom": "var(--wp--preset--spacing--2)",
						"left": "var(--wp--preset--spacing--3)"
					}
				},
				"border": {
					"width": "0px",
					"radius": "0px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"cite": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":active": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--2)",
			"padding": {
				"right": "var(--wp--preset--spacing--2)",
				"left": "var(--wp--preset--spacing--2)"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--small)",
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"lineHeight": "var(--wp--custom--typography--line-height--400)"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
