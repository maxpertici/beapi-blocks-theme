{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"spacing": {
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "3-x-sm",
					"size": "var(--wp--custom--spacings--3-x-sm)",
					"slug": "3-x-sm"
				},
				{
					"name": "2-x-sm",
					"size": "clamp(var(--wp--custom--spacings--3-x-sm), var(--wp--custom--spacings--3-x-sm) + (100vw - 480px) / (1024 - 480) * 4, var(--wp--custom--spacings--2-x-sm))",
					"slug": "2-x-sm"
				},
				{
					"name": "x-sm",
					"size": "clamp(var(--wp--custom--spacings--2-x-sm), var(--wp--custom--spacings--2-x-sm) + (100vw - 480px) / (1024 - 480) * 4, var(--wp--custom--spacings--x-sm))",
					"slug": "x-sm"
				},
				{
					"name": "sm",
					"size": "clamp(var(--wp--custom--spacings--x-sm), var(--wp--custom--spacings--x-sm) + (100vw - 480px) / (1024 - 480) * 4, var(--wp--custom--spacings--sm))",
					"slug": "sm"
				},
				{
					"name": "md",
					"size": "clamp(var(--wp--custom--spacings--sm), var(--wp--custom--spacings--sm) + (100vw - 480px) / (1024 - 480) * 8, var(--wp--custom--spacings--md))",
					"slug": "md"
				},
				{
					"name": "lg",
					"size": "clamp(var(--wp--custom--spacings--md), var(--wp--custom--spacings--md) + (100vw - 480px) / (1024 - 480) * 8, var(--wp--custom--spacings--lg))",
					"slug": "lg"
				},
				{
					"name": "x-lg",
					"size": "clamp(var(--wp--custom--spacings--lg), var(--wp--custom--spacings--lg) + (100vw - 480px) / (1024 - 480) * 8, var(--wp--custom--spacings--x-lg))",
					"slug": "x-lg"
				},
				{
					"name": "2-x-lg",
					"size": "clamp(var(--wp--custom--spacings--x-lg), var(--wp--custom--spacings--x-lg) + (100vw - 480px) / (1024 - 480) * 32, var(--wp--custom--spacings--2-x-lg))",
					"slug": "2-x-lg"
				},
				{
					"name": "3-x-lg",
					"size": "clamp(var(--wp--custom--spacings--2-x-lg), var(--wp--custom--spacings--2-x-lg) + (100vw - 480px) / (1024 - 480) * 48, var(--wp--custom--spacings--3-x-lg))",
					"slug": "3-x-lg"
				},
				{
					"name": "4-x-lg",
					"size": "clamp(var(--wp--custom--spacings--3-x-lg), var(--wp--custom--spacings--3-x-lg) + (100vw - 480px) / (1024 - 480) * 40, var(--wp--custom--spacings--4-x-lg))",
					"slug": "4-x-lg"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		}
	}
}