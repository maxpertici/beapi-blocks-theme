{
  "version": 3,
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "styles": {
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400"
        }
      },
      "h1": {
        "typography": {
					"fontSize": "var(--wp--preset--font-size--xxl)",
					"lineHeight": "1.11"
				}
      },
      "h2": {
        "typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.17"
				}
      },
      "h3": {
        "typography": {
					"fontSize": "var(--wp--preset--font-size--l)",
					"lineHeight": "1.24"
				}
      },
      "h4": {
        "typography": {
					"fontSize": "var(--wp--preset--font-size--m)",
					"lineHeight": "1.28"
				}
      },
      "h5": {
        "typography": {
					"fontSize": "var(--wp--preset--font-size--s)",
					"lineHeight": "1.33"
				}
      },
      "h6": {
        "typography": {
					"fontSize": "var(--wp--preset--font-size--xs)",
					"lineHeight": "1.31"
				}
      }
    }
  }
}