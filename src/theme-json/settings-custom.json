{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"custom": {
			"default": {
				"fontWeight": "300",
				"lineHeight": "1.5"
			},
			"heading": {
				"fontWeight": "400"
			},
			"h1": {
				"fontWeight": "var(--wp--custom--heading--font-weight)",
				"lineHeight": "1.11"
			},
			"h2": {
				"fontWeight": "var(--wp--custom--heading--font-weight)",
				"lineHeight": "1.17"
			},
			"h3": {
				"fontWeight": "var(--wp--custom--heading--font-weight)",
				"lineHeight": "1.24"
			},
			"h4": {
				"fontWeight": "var(--wp--custom--heading--font-weight)",
				"lineHeight": "1.28"
			},
			"h5": {
				"fontWeight": "var(--wp--custom--heading--font-weight)",
				"lineHeight": "1.33"
			},
			"h6": {
				"fontWeight": "500",
				"lineHeight": "1.31"
			},
			"layout": {
				"contentSize": "760px",
				"wideSize": "1200px",
				"mobileExternalGutter": "20px",
				"desktopExternalGutter": "75px",
				"externalGutterDelta": "55",
				"fluidExternalGutter": "clamp(var(--wp--custom--layout--mobile-external-gutter), var(--wp--custom--layout--mobile-external-gutter) + (100vw - 480px) / (1024 - 480) * var(--wp--custom--layout--external-gutter-delta), var(--wp--custom--layout--desktop-external-gutter))",
				"mobileBlockHorizontalGap": "var(--wp--preset--spacing--md)",
				"desktopBlockHorizontalGap": "var(--wp--preset--spacing--2-xl)",
				"blockHorizontalGapDelta": "48",
				"fluidBlockHorizontalGap": "clamp(var(--wp--custom--layout--mobile-block-horizontal-gap), var(--wp--custom--layout--mobile-block-horizontal-gap) + (100vw - 480px) / (1024 - 480) * var(--wp--custom--layout--block-horizontal-gap-delta), var(--wp--custom--layout--desktop-block-horizontal-gap))"
			}
		}
	}
}
