{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"custom": {
			"default": {
				"lineHeight": "1.5",
				"fontWeight": "300"
			},
			"heading": {
				"fontWeight": "400"
			},
			"h1": {
				"lineHeight": "1.11"
			},
			"h2": {
				"lineHeight": "1.17"
			},
			"h3": {
				"lineHeight": "1.24"
			},
			"h4": {
				"lineHeight": "1.28"
			},
			"h5": {
				"lineHeight": "1.33"
			},
			"h6": {
				"lineHeight": "1.31"
			},
			"layout": {
				"contentSize": "760px",
				"wideSize": "1200px",
				"mobileExternalGutter": "20px",
				"desktopExternalGutter": "75px",
				"externalGutterDelta": "55",
				"fluidExternalGutter": "clamp(var(--wp--custom--layout--mobile-external-gutter), var(--wp--custom--layout--mobile-external-gutter) + (100vw - 480px) / (1024 - 480) * var(--wp--custom--layout--external-gutter-delta), var(--wp--custom--layout--desktop-external-gutter))"
			}
		}
	}
}