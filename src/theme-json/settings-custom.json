{
  "version": 3,
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "settings": {
    "custom": {
      "default": {
        "lineHeight": "1.5",
        "fontWeight": "300"
      },
      "externalGutter": "clamp(25px, 25px + (100vw - 480px) / (1024 - 480) * 50, 75px)",
      "heading": {
        "fontWeight": "400"
      },
      "h1": {
        "lineHeight": "1.11"
      },
      "h2": {
        "lineHeight": "1.17"
      },
      "h3": {
        "lineHeight": "1.24"
      },
      "h4": {
        "lineHeight": "1.28"
      },
      "h5": {
        "lineHeight": "1.33"
      },
      "h6": {
        "lineHeight": "1.31"
      },
      "spacings": {
        "xxxs": "4px",
        "xxs": "8px",
        "xs": "12px",
        "sm": "16px",
        "md": "24px",
        "lg": "32px",
        "xl": "40px",
        "xxl": "72px",
        "xxxl": "120px",
        "xxxxl": "160px"
      }
    }
  }
}