{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"layout": {
			"contentSize": "min(100vw - var(--wp--custom--layout--fluid-external-gutter) * 2, var(--wp--custom--layout--content-size))",
			"wideSize": "min(100vw - var(--wp--custom--layout--fluid-external-gutter) * 2, var(--wp--custom--layout--wide-size))"
		},
		"position": {
			"sticky": true
		}
	}
}
